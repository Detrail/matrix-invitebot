# Copy this to .env (or paste these into Portainer's stack
# "Environment variables" editor) and fill in real values.
# Never commit the filled-in version to version control.

MATRIX_USERNAME=usernamehere
MATRIX_PASSWORD=changeme

# From your account's Security & Privacy settings in Element.
# This unlocks Secure Secret Storage (cross-signing keys + key
# backup) — treat it like a master password, not a room-scoped key.
BOT_RECOVERY_KEY=

# Passphrase used to decrypt element-keys-shareable.txt on import,
# if you're seeding the bot with a manual Element key export.
KEY_EXPORT_PASSPHRASE=

# Rooms the bot invites people into.
MATRIX_HOMESERVER=
SPACE_CHILD_ROOMS=!room1:matrix.org,!room2:matrix.org

#Welcome trigger (ie. !welcome)
WELCOME_TRIGGER=!welcome

# Rooms where trigger is accepted from. Keep this tight — anyone
# who can message the bot in one of these rooms can self-invite
# into every SPACE_CHILD_ROOMS room, with full history access.
TRIGGER_ROOMS=!lobby:matrix.org
